# Godot 4 - Files to ignore
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono / C# specific
.mono/
data_*/
mono_crash.*.json

# System / IDE
.vs/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Logs & backups
*.log
*.bak
*.orig
*~

# Editor scratch files (Godot writes these next to a scene while saving and
# does not always clean them up).
*.tscn*.tmp
*.tres*.tmp

# ZCode / editor local state
.zcode/

# Local dev tooling, not part of the game. The MCP bridge addon is installed
# per-machine; its wiring in project.godot (autoload + enabled plugin + port)
# is hidden with skip-worktree instead, since that file is tracked:
#     git update-index --skip-worktree project.godot
# To make project.godot editable/committable again (e.g. to add a real
# autoload), undo it first:
#     git update-index --no-skip-worktree project.godot
addons/

# Windows export output (build artifacts)
build/
